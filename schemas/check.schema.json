{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sihuangtech/probelune-contracts/schemas/check.schema.json",
  "title": "Probelune v1 Check",
  "type": "object",
  "required": [
    "type",
    "target"
  ],
  "properties": {
    "type": {
      "enum": [
        "http",
        "tcp",
        "udp",
        "ping",
        "dns",
        "mtr",
        "traceroute"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 10
    },
    "method": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "default": "GET"
    },
    "headers": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "expected_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599
    },
    "contains": {
      "type": "string",
      "maxLength": 4096
    },
    "follow_redirects": {
      "type": "boolean",
      "default": false
    },
    "insecure_tls": {
      "type": "boolean",
      "default": false
    },
    "certificate_min_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "default": 0
    },
    "dns_record": {
      "enum": [
        "A",
        "AAAA",
        "CNAME",
        "MX",
        "TXT",
        "NS",
        "SOA"
      ]
    },
    "resolver": {
      "type": "string"
    },
    "expected_dns": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 4
    },
    "size": {
      "type": "integer",
      "minimum": 16,
      "maximum": 1400,
      "default": 32
    },
    "max_loss": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "family": {
      "enum": [
        "auto",
        "ipv4",
        "ipv6"
      ]
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "udp_payload": {
      "type": "string",
      "maxLength": 16384
    },
    "udp_encoding": {
      "enum": [
        "text",
        "hex"
      ],
      "default": "text"
    },
    "udp_expected": {
      "type": "string",
      "maxLength": 16384
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "udp"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "port",
          "udp_payload"
        ],
        "properties": {
          "port": {
            "minimum": 1,
            "maximum": 65535
          },
          "udp_payload": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
